{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:lorelum:judge:code-target:v1",
  "title": "CodeTarget",
  "definitions": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "text"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "text": { "type": "string" } }
    },
    "files": { "type": "array", "items": { "$ref": "#/definitions/file" } }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "const": "snippet" },
        "text": { "type": "string" },
        "name": { "type": "string" },
        "language": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "files"],
      "properties": {
        "kind": { "const": "files" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "text"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "text": { "type": "string" },
              "role": { "enum": ["target", "context", "requirement", "opinion"] }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "const": "diff" },
        "text": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "old", "new"],
      "properties": {
        "kind": { "const": "comparison" },
        "old": { "$ref": "#/definitions/files" },
        "new": { "$ref": "#/definitions/files" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "const": "local" },
        "path": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "selection"],
      "properties": {
        "kind": { "const": "git" },
        "path": { "type": "string", "minLength": 1 },
        "selection": {
          "enum": ["staged", "unstaged", "untracked", "commit", "compare", "branch", "working"]
        },
        "base": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "minLength": 1 },
        "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "parent": { "type": "integer", "minimum": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": { "kind": { "const": "github" }, "url": { "type": "string", "minLength": 1 } }
    }
  ]
}
