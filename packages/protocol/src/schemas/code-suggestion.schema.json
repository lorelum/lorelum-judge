{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:lorelum:judge:code-suggestion:v1",
  "title": "CodeSuggestionRecord",
  "anyOf": [{ "$ref": "#/$defs/result" }, { "$ref": "#/$defs/report" }],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "text": { "type": "string", "minLength": 1 },
    "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "texts": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "startLine", "endLine"],
      "properties": {
        "itemId": { "$ref": "#/$defs/id" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "problemId",
        "evidenceIds",
        "location",
        "category",
        "problem",
        "priorityRationale",
        "direction",
        "impact",
        "checks",
        "uncertainPremises",
        "alternatives"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "problemId": { "$ref": "#/$defs/id" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "location": { "$ref": "#/$defs/location" },
        "category": { "enum": ["required", "optional", "preference"] },
        "problem": { "$ref": "#/$defs/text" },
        "priorityRationale": { "$ref": "#/$defs/text" },
        "direction": { "$ref": "#/$defs/text" },
        "impact": { "$ref": "#/$defs/text" },
        "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "uncertainPremises": { "$ref": "#/$defs/texts" },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direction", "applicability", "tradeoffs"],
            "properties": {
              "direction": { "$ref": "#/$defs/text" },
              "applicability": { "$ref": "#/$defs/text" },
              "tradeoffs": { "$ref": "#/$defs/text" }
            }
          }
        },
        "example": { "$ref": "#/$defs/text" }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "evidenceIds", "location"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "suggestions", "omissions"],
      "properties": {
        "schema": { "const": "lorelum.judge.code-suggestion-result/v1" },
        "suggestions": { "type": "array", "items": { "$ref": "#/$defs/suggestion" } },
        "omissions": { "type": "array", "items": { "$ref": "#/$defs/omission" } }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "evaluationIdentity",
        "sourceIdentity",
        "codeIdentity",
        "selectedProblemIds",
        "gaps",
        "limitations"
      ],
      "properties": {
        "schema": { "const": "lorelum.judge.code-suggestion-report/v1" },
        "status": { "enum": ["completed", "partial", "failed", "cancelled"] },
        "evaluationIdentity": { "$ref": "#/$defs/identity" },
        "sourceIdentity": { "$ref": "#/$defs/identity" },
        "codeIdentity": { "$ref": "#/$defs/identity" },
        "selectedProblemIds": { "$ref": "#/$defs/ids" },
        "result": { "$ref": "#/$defs/result" },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "problemId": { "$ref": "#/$defs/id" },
              "code": { "$ref": "#/$defs/text" },
              "message": { "$ref": "#/$defs/text" }
            }
          }
        },
        "limitations": { "$ref": "#/$defs/texts" },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "provider", "endpointIdentity", "model"],
          "properties": {
            "kind": { "const": "llm" },
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "required": ["protocol", "adapterVersion"],
              "properties": {
                "protocol": { "$ref": "#/$defs/text" },
                "adapterVersion": { "$ref": "#/$defs/text" }
              }
            },
            "endpointIdentity": { "$ref": "#/$defs/identity" },
            "model": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "name"],
              "properties": {
                "provider": { "$ref": "#/$defs/text" },
                "name": { "$ref": "#/$defs/text" },
                "version": { "$ref": "#/$defs/text" }
              }
            },
            "decoding": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "temperature": { "type": "number", "minimum": 0 },
                "topP": { "type": "number", "minimum": 0, "maximum": 1 },
                "maxTokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
              }
            }
          }
        },
        "responseMetadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": { "$ref": "#/$defs/text" },
            "model": { "$ref": "#/$defs/text" },
            "responseId": { "$ref": "#/$defs/text" },
            "finishReason": { "$ref": "#/$defs/text" },
            "status": { "$ref": "#/$defs/text" },
            "usage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "promptTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "completionTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "totalTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
              }
            }
          }
        },
        "requestIdentity": { "$ref": "#/$defs/identity" },
        "responseIdentity": { "$ref": "#/$defs/identity" },
        "error": { "$ref": "#/$defs/text" }
      }
    }
  }
}
