{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:lorelum:judge:calibration-report:v1",
  "title": "CalibrationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "datasetIdentity",
    "policyIdentity",
    "definitionIdentity",
    "instrumentIdentity",
    "confidenceLevel",
    "scopes"
  ],
  "properties": {
    "schema": { "const": "lorelum.judge.calibration-report/v1" },
    "datasetIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "policyIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "definitionIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "instrumentIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "confidenceLevel": { "enum": [0.9, 0.95, 0.99] },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskClass",
          "evidenceShape",
          "criterionId",
          "taskGroups",
          "cases",
          "observations",
          "caseCounts",
          "failureCounts",
          "falseAccept",
          "falseReject",
          "abstention",
          "disagreement",
          "eligible",
          "reasons"
        ],
        "properties": {
          "taskClass": { "type": "string", "minLength": 1 },
          "evidenceShape": { "type": "string", "minLength": 1 },
          "criterionId": { "type": "string", "minLength": 1 },
          "taskGroups": { "type": "integer", "minimum": 0 },
          "cases": { "type": "integer", "minimum": 0 },
          "observations": { "type": "integer", "minimum": 0 },
          "caseCounts": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "failureCounts": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "rubric",
                "fixture_label",
                "evidence",
                "prompt",
                "provider",
                "threshold",
                "measurement_noise",
                "execution",
                "unattributed"
              ]
            },
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "falseAccept": { "$ref": "#/definitions/rate" },
          "falseReject": { "$ref": "#/definitions/rate" },
          "abstention": { "$ref": "#/definitions/rate" },
          "disagreement": { "$ref": "#/definitions/rate" },
          "eligible": { "type": "boolean" },
          "reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "insufficient_coverage",
                "missing_denominator",
                "false_accept_threshold",
                "false_reject_threshold",
                "abstention_threshold",
                "disagreement_threshold"
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "estimate": { "type": "number", "minimum": 0, "maximum": 1 },
        "lowerBound": { "type": "number", "minimum": 0, "maximum": 1 },
        "upperBound": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
