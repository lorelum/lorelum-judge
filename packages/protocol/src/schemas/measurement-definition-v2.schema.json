{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:lorelum:judge:measurement-definition:v2",
  "title": "MeasurementDefinitionV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "criteria", "metadata"],
  "properties": {
    "schema": { "const": "lorelum.judge.measurement-definition/v2" },
    "id": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:lorelum:judge:criterion:v1" }
    },
    "metadata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "role"],
        "properties": {
          "criterionId": { "type": "string", "minLength": 1 },
          "role": { "enum": ["decisive", "advisory"] },
          "covers": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "appliesTo": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rubricId": { "type": "string", "minLength": 1 },
        "rubricIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "contractIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "migratedFrom": {
          "const": "lorelum.judge.measurement-definition/v1"
        },
        "sourceIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
