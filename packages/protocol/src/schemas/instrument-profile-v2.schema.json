{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:lorelum:judge:instrument-profile:v2",
  "title": "InstrumentProfileV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "method"],
  "properties": {
    "schema": { "const": "lorelum.judge.instrument-profile/v2" },
    "method": {
      "oneOf": [{ "$ref": "#/definitions/programMethod" }, { "$ref": "#/definitions/llmMethod" }]
    }
  },
  "definitions": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "decoding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": { "type": "number", "minimum": 0 },
        "topP": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxTokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "programMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "checker",
        "implementationVersion",
        "resultProtocolVersion",
        "parserVersion",
        "runtime",
        "repetitions"
      ],
      "properties": {
        "kind": { "const": "program" },
        "checker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "contentIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "implementationVersion": { "type": "string", "minLength": 1 },
        "resultProtocolVersion": { "type": "string", "minLength": 1 },
        "parserVersion": { "type": "string", "minLength": 1 },
        "runtime": { "$ref": "#/definitions/runtime" },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "llmMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "provider",
        "endpointIdentity",
        "model",
        "decoding",
        "promptIdentity",
        "compilerVersion",
        "renderVersion",
        "parserVersion",
        "runtime",
        "repetitions"
      ],
      "properties": {
        "kind": { "const": "llm" },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "adapterVersion"],
          "properties": {
            "protocol": { "type": "string", "minLength": 1 },
            "adapterVersion": { "type": "string", "minLength": 1 }
          }
        },
        "endpointIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "name"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "decoding": { "$ref": "#/definitions/decoding" },
        "promptIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "compilerVersion": { "type": "string", "minLength": 1 },
        "renderVersion": { "type": "string", "minLength": 1 },
        "parserVersion": { "type": "string", "minLength": 1 },
        "runtime": { "$ref": "#/definitions/runtime" },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  }
}
