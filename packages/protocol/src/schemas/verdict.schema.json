{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lorelum.judge.verdict/v1",
  "title": "Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "criterionId", "verdict", "evidenceIds"],
  "properties": {
    "schema": { "const": "lorelum.judge.verdict/v1" },
    "criterionId": { "type": "string", "minLength": 1 },
    "verdict": {
      "enum": [
        "met",
        "unmet",
        "strong",
        "adequate",
        "weak",
        "better",
        "equivalent",
        "worse",
        "unknown",
        "insufficient"
      ]
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "rationale": { "type": "string" }
  }
}
