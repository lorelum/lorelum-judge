{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:lorelum:judge:workflow-execution:v1",
  "title": "WorkflowExecution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "planIdentity",
    "planRevision",
    "workspaceIdentity",
    "authorizationIdentity",
    "status",
    "stopReason",
    "usage"
  ],
  "properties": {
    "schema": { "const": "workflow-execution/v1" },
    "planIdentity": { "$ref": "#/definitions/identity" },
    "planRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "workspaceIdentity": { "$ref": "#/definitions/identity" },
    "authorizationIdentity": { "$ref": "#/definitions/identity" },
    "status": { "enum": ["completed", "failed", "cancelled", "timed_out", "unknown"] },
    "stopReason": { "type": "string", "minLength": 1 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalTimeMs",
        "commandTimeMs",
        "modelCalls",
        "actions",
        "commands",
        "outputBytes"
      ],
      "properties": {
        "totalTimeMs": { "$ref": "#/definitions/count" },
        "commandTimeMs": { "$ref": "#/definitions/count" },
        "modelCalls": { "$ref": "#/definitions/count" },
        "actions": { "$ref": "#/definitions/count" },
        "commands": { "$ref": "#/definitions/count" },
        "outputBytes": { "$ref": "#/definitions/count" }
      }
    }
  },
  "definitions": {
    "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
