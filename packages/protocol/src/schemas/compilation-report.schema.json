{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:lorelum:judge:compilation-report:v1",
  "title": "CompilationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contractIdentity",
    "covered",
    "uncovered",
    "unsupported",
    "merged",
    "excluded"
  ],
  "properties": {
    "schema": { "const": "lorelum.judge.compilation-report/v1" },
    "contractIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "covered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptanceId", "criterionIds"],
        "properties": {
          "acceptanceId": { "type": "string", "minLength": 1 },
          "criterionIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "uncovered": { "type": "array", "items": { "$ref": "#/definitions/gap" } },
    "unsupported": { "type": "array", "items": { "$ref": "#/definitions/gap" } },
    "merged": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "mergedFrom"],
        "properties": {
          "criterionId": { "type": "string", "minLength": 1 },
          "mergedFrom": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "code", "reason"],
        "properties": {
          "criterionId": { "type": "string", "minLength": 1 },
          "code": { "enum": ["not_applicable", "conflict"] },
          "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    }
  },
  "definitions": {
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptanceId", "reason"],
      "properties": {
        "acceptanceId": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  }
}
