{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:lorelum:judge:workflow-plan:v1",
  "title": "WorkflowPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "sources",
    "task",
    "goal",
    "scope",
    "steps",
    "checks",
    "nonGoals",
    "missing",
    "conflicts"
  ],
  "properties": {
    "schema": { "const": "workflow-plan/v1" },
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "sources": { "type": "array", "items": { "$ref": "urn:lorelum:judge:workflow-source:v1" } },
    "task": { "$ref": "urn:lorelum:judge:task-contract:v1" },
    "goal": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/definitions/strings" },
    "steps": { "type": "array", "items": { "$ref": "#/definitions/workItem" } },
    "checks": { "type": "array", "items": { "$ref": "#/definitions/workItem" } },
    "nonGoals": { "$ref": "#/definitions/strings" },
    "missing": { "$ref": "#/definitions/strings" },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "sourceIds"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "sourceIds": { "$ref": "#/definitions/strings" }
        }
      }
    }
  },
  "definitions": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "acceptanceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "acceptanceIds": { "$ref": "#/definitions/strings" }
      }
    }
  }
}
