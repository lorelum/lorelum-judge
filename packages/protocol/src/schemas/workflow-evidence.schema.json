{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:lorelum:judge:workflow-evidence:v1",
  "title": "WorkflowEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "executionIdentity", "candidateIdentity", "checks"],
  "properties": {
    "schema": { "const": "workflow-evidence/v1" },
    "executionIdentity": { "$ref": "#/definitions/identity" },
    "candidateIdentity": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "executable",
          "args",
          "cwd",
          "version",
          "environmentIdentity",
          "timeoutMs",
          "maxOutputBytes",
          "readPaths",
          "status",
          "exitCode",
          "stdout",
          "stderr"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "executable": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string", "minLength": 1 },
          "version": { "type": ["string", "null"], "minLength": 1 },
          "environmentIdentity": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
          "timeoutMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "maxOutputBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "readPaths": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "cancelled",
              "timed_out",
              "truncated",
              "unavailable",
              "not_started"
            ]
          },
          "exitCode": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" }
        }
      }
    }
  },
  "definitions": { "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
