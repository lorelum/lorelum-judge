{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:lorelum:judge:measurement-run:v2",
  "title": "MeasurementRunV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "definitionIdentity",
    "instrumentIdentity",
    "instrumentSource",
    "executionId",
    "evidenceIdentity",
    "verdicts"
  ],
  "properties": {
    "schema": { "const": "lorelum.judge.measurement-run/v2" },
    "id": { "type": "string", "minLength": 1 },
    "definitionIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "instrumentIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "instrumentSource": { "const": "declared" },
    "executionId": { "type": "string", "minLength": 1 },
    "evidenceIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "renderIdentity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "verdicts": {
      "type": "array",
      "items": { "$ref": "urn:lorelum:judge:verdict:v1" }
    }
  }
}
