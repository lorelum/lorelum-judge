{
  "name": "@lorelum/judge-runtime",
  "version": "0.0.0",
  "description": "Framework-neutral agent runtime for Lorelum Judge.",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
