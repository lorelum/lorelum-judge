{
  "name": "lorelum-judge-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun build ./scripts/repository-baseline.ts --outdir dist --target bun",
    "check": "biome check .",
    "check:repository": "bun run scripts/repository-baseline.ts",
    "check:write": "biome check --write .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun run check && bun run check:repository && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
